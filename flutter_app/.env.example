# Studyforge Flutter .env
# Android emulator → use 10.0.2.2 to reach your computer's localhost
# iOS simulator    → use localhost
# Real device      → use your computer's local IP (e.g. 192.168.1.x)

API_BASE_URL=http://10.0.2.2:8000

# Supabase — get from: Supabase Dashboard → Project Settings → API
# Use the ANON (public) key here, NOT the service role key
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
