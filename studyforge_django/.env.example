# ── Studyforge Django Backend .env ────────────────────────────────────────────
# Copy to .env and fill in your real values. Never commit .env.

# Django
SECRET_KEY=django-insecure-change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL — use Neon.tech (free) or local postgres
DB_NAME=studyforge
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Hugging Face free token — https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# File storage — local folder (dev) or Cloudinary (prod, free 25GB)
# Leave CLOUDINARY vars empty to use local storage
MEDIA_ROOT=media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT settings (optional overrides — defaults are fine)
# ACCESS_TOKEN_LIFETIME_HOURS=1
# REFRESH_TOKEN_LIFETIME_DAYS=30
